{
  "name": "notex",
  "version": "1.0.0",
  "private": true,
  "main": "index",
  "scripts": {
    "start": "expo start",
    "postinstall": "setup-skia-web public",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
