    "preweb": "npm run setup:skia-web",
    "start:dev": "expo start --dev-client"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-sqlite": "~58.0.15",
    "@shopify/react-native-skia": "2.14.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zustand": "^5.0.8",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.0",
    "expo-constants": "~58.0.10",
    "expo-linking": "~58.0.9",
    "lucide-react-native": "^0.511.0",
